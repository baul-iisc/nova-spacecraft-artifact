        // Store the first column of the matrix register as a vector
        EA = Rs1;
        // Size for a vector (3 doubles)
        const size_t mem_size = 24;
        std::vector<bool> byte_enable(mem_size, true);

        // Copy first column to memory buffer
        for (int i = 0; i < 3; i++) {
