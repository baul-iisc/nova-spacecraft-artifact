//# Matrix Arithmetic Line Double Precision Micro Execute
def template MatrixArithLineDoubleMicroExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
        trace::InstRecord *traceData) const
    {   
        DPRINTF(MatRegs, "Executing %s with dest reg %d\n", 
    mnemonic, machInst.mrd >= ACC_REG_START ? (machInst.mrd + ACC_REG_START) : machInst.mrd);
    
        %(op_decl)s;
        %(op_rd)s;

        uint32_t i = microIdx;
        for (int row; row < 3; row++) {
            for(int k = 0; k < 3; k++) {
                %(code)s;
                i++;
            }
        }

        %(op_wb)s;
        return NoFault;
    }
}};

