// for src/arch/riscv/isa/templates/matrix.isa

def template MatrixVectorLoadMicroDeclare {{
    class %(class_name)s : public %(base_class)s
    {
      private:
        RegId srcRegIdxArr[2];
        RegId destRegIdxArr[1];
        Request::Flags memAccessFlags;
      public:
        %(class_name)s(ExtMachInst _machInst);
        %(class_name)s(ExtMachInst _machInst, uint32_t _microIdx);
        
        Fault execute(ExecContext *, trace::InstRecord *) const override;
        Fault initiateAcc(ExecContext *, trace::InstRecord *) const override;
        Fault completeAcc(PacketPtr, ExecContext *,
                          trace::InstRecord *) const override;

        using %(base_class)s::generateDisassembly;
    };
}};

def template MatrixVectorLoadMicroConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst _machInst, uint32_t _microIdx)
    : %(base_class)s(
            "%(mnemonic)s", _machInst, %(op_class)s, _microIdx),
        memAccessFlags(0)
    {
        %(set_reg_idx_arr)s;
        _numSrcRegs = 0;
        _numDestRegs = 0;
        setDestRegIdx(_numDestRegs++, matRegClass[_machInst.mrd]);
        _numTypedDestRegs[MatRegClass]++;
        setSrcRegIdx(_numSrcRegs++, intRegClass[_machInst.rs1]);
        setSrcRegIdx(_numSrcRegs++, intRegClass[_machInst.rs2]);
        this->flags[IsLoad] = true;
    }
}};

def template MatrixVectorLoadMicroExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        Addr EA;

        %(op_decl)s;
        %(op_rd)s;

        // Get a temporary buffer for the memory data
        uint8_t tempBuffer[24];  // Space for 3 doubles
        
        // Load vector into the first column of the matrix register
        EA = Rs1;
        // Size for a vector (3 doubles)
        const size_t mem_size = 24;
        std::vector<bool> byte_enable(mem_size, true);

        Fault fault = xc->readMem(EA, tempBuffer, mem_size, 
                              memAccessFlags, byte_enable);
        if (fault != NoFault)
            return fault;

        // Copy vector elements to first column, zero out rest
        for (int i = 0; i < 3; i++) {
            // Copy from temp buffer to first column
            uint64_t doubleVal;
            memcpy(&doubleVal, tempBuffer + i*8, sizeof(doubleVal));
            Mrd_ud[i * 3] = doubleVal;
            
            // Initialize other columns to 0
            Mrd_ud[i * 3 + 1] = 0;
            Mrd_ud[i * 3 + 2] = 0;
        }

        %(op_wb)s;
        return NoFault;
    }
}};

def template MatrixVectorLoadMicroInitiateAcc {{
    Fault
    %(class_name)s::initiateAcc(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        Addr EA;
        %(op_decl)s;
        %(op_rd)s;

        EA = Rs1;
        // Size for a vector (3 doubles)
        uint32_t mem_size = 24;
        const std::vector<bool> byte_enable(mem_size, true);
        
        Fault fault = initiateMemRead(xc, EA, mem_size, memAccessFlags,
                                  byte_enable);

        return fault;
    }
}};


def template MatrixVectorLoadMicroCompleteAcc {{
    Fault
    %(class_name)s::completeAcc(PacketPtr pkt, ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        %(op_decl)s;
        %(op_rd)s;
        
        // Copy vector elements to first column, zero out rest
        for (int i = 0; i < 3; i++) {
            // Copy data from packet to first column
            uint64_t doubleVal;
            memcpy(&doubleVal, pkt->getPtr<uint8_t>() + i*8, sizeof(doubleVal));
            Mrd_ud[i * 3] = doubleVal;
            
            // Initialize other columns to 0
            Mrd_ud[i * 3 + 1] = 0;
            Mrd_ud[i * 3 + 2] = 0;
        }

        %(op_wb)s;
        return NoFault;
    }
}};


