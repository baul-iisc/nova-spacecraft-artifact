// Update these templates in src/arch/riscv/isa/templates/matrix.isa
// to fix the register handling for matrix-vector operations

def template MatrixVectorMulMicroDeclare {{
    class %(class_name)s : public %(base_class)s
    {
      private:
        RegId srcRegIdxArr[2];  // One for matrix, one for scalar
        RegId destRegIdxArr[1];
      public:
        %(class_name)s(ExtMachInst _machInst);
        %(class_name)s(ExtMachInst _machInst, uint32_t _microIdx);
        
        Fault execute(ExecContext *, trace::InstRecord *) const override;

        using %(base_class)s::generateDisassembly;
    };
}};

def template MatrixVectorMulMicroConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst _machInst, uint32_t _microIdx)
    : %(base_class)s(
            "%(mnemonic)s", _machInst, %(op_class)s, _microIdx)
    {
        %(set_reg_idx_arr)s;
        _numSrcRegs = 0;
        _numDestRegs = 0;
        setDestRegIdx(_numDestRegs++, matRegClass[_machInst.mrd]);
        _numTypedDestRegs[MatRegClass]++;
        setSrcRegIdx(_numSrcRegs++, matRegClass[_machInst.mrs1]);
        setSrcRegIdx(_numSrcRegs++, intRegClass[_machInst.rs1]);  // Use rs1 as a scalar
    }
}};

def template MatrixVectorMulMicroExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        %(op_decl)s;
        %(op_rd)s;

        // Get scalar value from Rs1 (scalar register)
        double scalar_value = bitsToFloat64(Rs1);
        
        // Matrix-vector multiply with scalar broadcast
        for (int i = 0; i < 3; i++) {
            double sum = 0.0;
            for (int j = 0; j < 3; j++) {
                double matrixElem = bitsToFloat64(Mrs1_ud[i * 3 + j]);
                sum += matrixElem * scalar_value;
            }
            // Store result in first column
            Mrd_ud[i * 3] = floatToBits64(sum);
            // Zero out other columns
            Mrd_ud[i * 3 + 1] = 0;
            Mrd_ud[i * 3 + 2] = 0;
        }

        %(op_wb)s;
        return NoFault;
    }
}};

// Update the other matrix-vector operation templates similarly
def template MatrixVectorMacMicroDeclare {{
    class %(class_name)s : public %(base_class)s
    {
      private:
        RegId srcRegIdxArr[2];  // One for matrix, one for scalar
        RegId destRegIdxArr[1];
      public:
        %(class_name)s(ExtMachInst _machInst);
        %(class_name)s(ExtMachInst _machInst, uint32_t _microIdx);
        
        Fault execute(ExecContext *, trace::InstRecord *) const override;

        using %(base_class)s::generateDisassembly;
    };
}};

def template MatrixVectorMacMicroConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst _machInst, uint32_t _microIdx)
    : %(base_class)s(
            "%(mnemonic)s", _machInst, %(op_class)s, _microIdx)
    {
        %(set_reg_idx_arr)s;
        _numSrcRegs = 0;
        _numDestRegs = 0;
        setDestRegIdx(_numDestRegs++, matRegClass[_machInst.mrd]);
        _numTypedDestRegs[MatRegClass]++;
        setSrcRegIdx(_numSrcRegs++, matRegClass[_machInst.mrs1]);
        setSrcRegIdx(_numSrcRegs++, intRegClass[_machInst.rs1]);  // Use rs1 as a scalar
    }
}};

def template MatrixVectorMacMicroExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        %(op_decl)s;
        %(op_rd)s;

        // Get scalar value from Rs1 (scalar register)
        double scalar_value = bitsToFloat64(Rs1);
        
        // Matrix-vector multiply-accumulate with scalar broadcast
        for (int i = 0; i < 3; i++) {
            double sum = bitsToFloat64(Mrd_ud[i * 3]); // Accumulate with existing value
            for (int j = 0; j < 3; j++) {
                double matrixElem = bitsToFloat64(Mrs1_ud[i * 3 + j]);
                sum += matrixElem * scalar_value;
            }
            // Store result in first column
            Mrd_ud[i * 3] = floatToBits64(sum);
            // Leave other columns unchanged
        }

        %(op_wb)s;
        return NoFault;
    }
}};

def template MatrixVectorAddMicroDeclare {{
    class %(class_name)s : public %(base_class)s
    {
      private:
        RegId srcRegIdxArr[2];  // One for matrix, one for scalar
        RegId destRegIdxArr[1];
      public:
        %(class_name)s(ExtMachInst _machInst);
        %(class_name)s(ExtMachInst _machInst, uint32_t _microIdx);
        
        Fault execute(ExecContext *, trace::InstRecord *) const override;

        using %(base_class)s::generateDisassembly;
    };
}};

def template MatrixVectorAddMicroConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst _machInst, uint32_t _microIdx)
    : %(base_class)s(
            "%(mnemonic)s", _machInst, %(op_class)s, _microIdx)
    {
        %(set_reg_idx_arr)s;
        _numSrcRegs = 0;
        _numDestRegs = 0;
        setDestRegIdx(_numDestRegs++, matRegClass[_machInst.mrd]);
        _numTypedDestRegs[MatRegClass]++;
        setSrcRegIdx(_numSrcRegs++, matRegClass[_machInst.mrs1]);
        setSrcRegIdx(_numSrcRegs++, intRegClass[_machInst.rs1]);  // Use rs1 as a scalar
    }
}};

def template MatrixVectorAddMicroExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        %(op_decl)s;
        %(op_rd)s;

        // Get scalar value from Rs1 (scalar register)
        double scalar_value = bitsToFloat64(Rs1);
        
        // Matrix-vector add with scalar broadcast
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                double matrixElem = bitsToFloat64(Mrs1_ud[i * 3 + j]);
                double result = matrixElem + scalar_value;
                Mrd_ud[i * 3 + j] = floatToBits64(result);
            }
        }

        %(op_wb)s;
        return NoFault;
    }
}};

def template MatrixVectorSubMicroDeclare {{
    class %(class_name)s : public %(base_class)s
    {
      private:
        RegId srcRegIdxArr[2];  // One for matrix, one for scalar
        RegId destRegIdxArr[1];
      public:
        %(class_name)s(ExtMachInst _machInst);
        %(class_name)s(ExtMachInst _machInst, uint32_t _microIdx);
        
        Fault execute(ExecContext *, trace::InstRecord *) const override;

        using %(base_class)s::generateDisassembly;
    };
}};

def template MatrixVectorSubMicroConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst _machInst, uint32_t _microIdx)
    : %(base_class)s(
            "%(mnemonic)s", _machInst, %(op_class)s, _microIdx)
    {
        %(set_reg_idx_arr)s;
        _numSrcRegs = 0;
        _numDestRegs = 0;
        setDestRegIdx(_numDestRegs++, matRegClass[_machInst.mrd]);
        _numTypedDestRegs[MatRegClass]++;
        setSrcRegIdx(_numSrcRegs++, matRegClass[_machInst.mrs1]);
        setSrcRegIdx(_numSrcRegs++, intRegClass[_machInst.rs1]);  // Use rs1 as a scalar
    }
}};

def template MatrixVectorSubMicroExecute {{
    Fault
    %(class_name)s::execute(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        %(op_decl)s;
        %(op_rd)s;

        // Get scalar value from Rs1 (scalar register)
        double scalar_value = bitsToFloat64(Rs1);
        
        // Matrix-vector subtract with scalar broadcast
        for (int i = 0; i < 3; i++) {
            for (int j = 0; j < 3; j++) {
                double matrixElem = bitsToFloat64(Mrs1_ud[i * 3 + j]);
                double result = matrixElem - scalar_value;
                Mrd_ud[i * 3 + j] = floatToBits64(result);
            }
        }

        %(op_wb)s;
        return NoFault;
    }
}};
