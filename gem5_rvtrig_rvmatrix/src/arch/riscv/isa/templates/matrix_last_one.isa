def template MatrixMacroConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst _machInst)
        : %(base_class)s("%(mnemonic)s", _machInst, %(op_class)s)
    {
        %(set_reg_idx_arr)s;
        %(constructor)s;

        StaticInstPtr microop;
        
        // Spawn four microops, each handling a different memory location
        for (uint32_t i = 0; i < 4; i++) {
            microop = new %(class_name)sMicro(_machInst, i);
            microop->setDelayedCommit();
            //microop->setFlag(StaticInst::IsMicroop);
            this->microops.push_back(microop);

            // Debug print
            DPRINTF(MatRegs, "Created microop %d for row %d\n", i, i);
            //DPRINTF(MatRegs, "Created microop %u for element index %u\n", i, i);
        }
        this->microops.front()->setFirstMicroop();
        this->microops.back()->setLastMicroop();

        // Debug print
        DPRINTF(MatRegs, "MatrixMacroConstructor: Created 4 microops\n");
        //DPRINTF(MatRegs, "MatrixMacroConstructor: Created 16 microops\n");
    }
}};

